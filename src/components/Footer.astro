---
<footer>
	<p>Horarios en hora argentina (ART). Datos: ESPN, Promiedos y Olé.</p>
	<p>
		Calendario público:
		<a href={calendar.subscribe} rel="noopener" target="_blank">Suscribirse en Google Calendar</a> ·
		<a href={calendar.webcal}>Apple / iCal</a> ·
		<a href={calendar.ical}>Enlace .ics</a> ·
		<a href={calendar.embed} rel="noopener" target="_blank">Ver calendario</a>
	</p>
	<p><a href="fixtures.json">fixtures.json</a></p>
	<div class="author">
		<span>Hecho por <strong>{AUTHOR.name}</strong></span>
		<span class="social">
			<a href={AUTHOR.instagram} target="_blank" rel="noopener" aria-label={`Instagram de ${AUTHOR.name}`} title="Instagram"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d={IG} /></svg></a>
			<a href={AUTHOR.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn de ${AUTHOR.name}`} title="LinkedIn"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d={LI} /></svg></a>
		</span>
	</div>
</footer>

<style>
	footer{max-width:720px;margin:8px auto 32px;padding:0 16px;font-size:.85rem;color:var(--muted);text-align:center}
	footer a{color:var(--navy2);font-weight:600}
	footer p{margin:6px 0}
	.author{margin:18px auto 0;max-width:360px;background:var(--navy);color:#fff;border-radius:14px;padding:12px 16px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px 16px;border:1px solid rgba(244,194,13,.45)}
	.author strong{color:var(--gold)}
	.social{display:inline-flex;gap:10px}
	.social a{color:var(--gold)!important;display:inline-grid;place-items:center;width:40px;height:40px;border-radius:50%;border:2px solid var(--gold);transition:background .15s,color .15s}
	.social a:hover,.social a:focus-visible{background:var(--gold);color:var(--navy)!important;outline:none}
	.social svg{display:block}
</style>
